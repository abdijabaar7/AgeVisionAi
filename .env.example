# AWS Rekognition credentials (use a short-lived role where supported)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Upload limit; default is 5 MB
AGE_ESTIMATION_MAX_FILE_SIZE_MB=5

# Required for production rate limiting. Local development uses a temporary
# in-memory limiter if these two values are empty; do not use that in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: requests per IP within the one-minute window (default 10)
RATE_LIMIT_REQUESTS=10
